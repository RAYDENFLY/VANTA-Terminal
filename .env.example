# ==============================================================================
# VANTA TERMINAL — CONFIGURATION TEMPLATE
# Local-first quantitative ML research workstation
# Strictly LOCAL RESEARCH · NO LIVE ORDERS
# ==============================================================================

# Runtime Ports (Strict: Port 8000 is forbidden)
VANTA_HOST=127.0.0.1
VANTA_BACKEND_PORT=8101
VANTA_FRONTEND_PORT=3000

# Next.js API client target
NEXT_PUBLIC_API_URL=http://127.0.0.1:8101

# Storage Paths (Local HDD storage)
VANTA_DATA_DIR=D:/vanta-terminal/data
VANTA_ARTIFACTS_DIR=D:/vanta-terminal/artifacts
VANTA_DATABASE_PATH=D:/vanta-terminal/experiments/vanta.sqlite

# Concurrency & Memory Controls (Laptop friendly: 16 GB RAM / 4 cores)
VANTA_MAX_WORKERS=1
VANTA_NUM_THREADS=2
VANTA_CHUNK_SIZE_CANDLES=50000

# Exchange Adapter Configurations (AsterDEX Futures V3 Pro API)
# Official docs: https://github.com/asterdex/api-docs
ASTERDEX_API_BASE_URL=https://fapi.asterdex.com
ASTERDEX_TESTNET_BASE_URL=https://fapi.asterdex-testnet.com
ASTERDEX_API_VERSION=FUTURES_V3_PRO
DATA_SOURCE_MODE=PUBLIC_DATA_ONLY
DATA_DEMO_FIXTURES_ONLY=true

# Safety Locks
VANTA_LIVE_ORDERS_ENABLED=false
VANTA_SIMULATION_MODE=true
